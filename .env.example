# Backend API URL for Dashboard production build
# Set this variable in Netlify Dashboard: Site configuration > Environment variables
VITE_API_URL=https://your-backend-api.com/api

# Must match the backend ORDER_EXPIRY_HOURS value. Controls how many hours
# after creation an unpaid order is shown as "about to expire" in the UI.
# The actual expiration is enforced server-side; this is purely for display.
VITE_ORDER_EXPIRY_HOURS=3
