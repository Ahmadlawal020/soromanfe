# Backend API URL for Dashboard production build
# Set this variable in Netlify Dashboard: Site configuration > Environment variables
VITE_API_URL=https://your-backend-api.com/api

# Public origin of the deployed dashboard, no trailing slash. Substituted into
# the og:/twitter: tags in index.html at build time. Set this in Netlify >
# Site configuration > Environment variables, or link previews ship a literal
# %VITE_SITE_URL% placeholder.
VITE_SITE_URL=https://your-dashboard-domain.com
